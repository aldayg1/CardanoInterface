# Python / uv
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
*.pyc

# Secrets — encrypted user data and wallet keys must never be committed
CardanoInterface/users/
CardanoInterface/wallets/

# Runtime artifacts
debug_main.log
last_update_check.txt

# Captured TUI sessions — these transcripts contain typed 24-word recovery
# phrases and wallet passwords in plaintext. Never commit them.
audit/logs/
audit/tmp/
audit/results/

# Fixture credentials, kept on the operator's machine only
CREDENTIALS.local.md

# Agent / dev tooling — not part of CardanoInterface
.agents/
.claude/
.opencode/
.zcode/
AGENTS.md
CLAUDE.md
BACKLOG.md
MULTISIG_SPEC.md
draft/
# audit/ stays untracked except the CI guard battery, which must exist on a
# fresh clone or the pipeline gate fails for every merge (git cannot
# re-include under an excluded directory, so the tree is narrowed instead).
audit/*
!audit/ci/
audit/ci/*
!audit/ci/source_guards.py
!audit/ci/rich_balance.py
.python-version

# Internal strategy — holds-for-renewal is not public. Never commit.
PRIVATE_ROADMAP.md

# Assessment queue — process evidence, not product (full provenance lives in
# testbuilder/kb/); the composed suite and the KB are the committed artifacts.
tests/_review/
testbuilder/kb/last_report.md
testbuilder/kb/sources/
